{
  "name": "property-hub",
  "version": "0.3.0",
  "private": true,
  "description": "Single-operator property compliance tracker (local prototype, fictional data only)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "seed": "tsx server/seed-cli.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && node e2e/run.mjs",
    "check": "tsc --noEmit && vitest run && vite build && node e2e/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^23.11.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
